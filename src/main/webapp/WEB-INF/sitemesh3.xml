<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!--
        Cau hinh Layout toan site voi SiteMesh Decorators 3 + Bootstrap 5.

        - Cac trang xac thuc (login/register/otp/forgot/reset/waiting) tu dung
          giao dien card rieng (khong header/footer) nen duoc loai tru khoi decorator.
        - Khu vuc /admin/* va /manager/* dung chung decorator admin.jsp (sidebar + topbar).
        - Tat ca cac trang con lai (home, product, profile...) dung decorator web.jsp
          (navbar + footer Bootstrap).
    -->

    <!-- Loai tru: khong trang tri cac trang dang nhap/dang ky/OTP -->
    <mapping path="/login" exclude="true"/>
    <mapping path="/register" exclude="true"/>
    <mapping path="/verify-otp" exclude="true"/>
    <mapping path="/resend-otp" exclude="true"/>
    <mapping path="/forgot-password" exclude="true"/>
    <mapping path="/reset-password" exclude="true"/>
    <mapping path="/waiting" exclude="true"/>
    <mapping path="/image" exclude="true"/>

    <!-- Khu vuc quan tri: sidebar + topbar Bootstrap -->
    <mapping path="/admin/*" name="admin" decorator="admin.jsp"/>
    <mapping path="/manager/*" name="admin" decorator="admin.jsp"/>

    <!-- Toan bo trang con lai: navbar + footer Bootstrap -->
    <mapping path="/*" decorator="/web.jsp"/>
</sitemesh>
